# ─── General ─────────────────────────────────────────────────────
PICKLE_DOMAIN=pickle.pw
IMAGE_TAG=latest
DATA_PATH=/mnt/data
CADDY_ACME_EMAIL=admin@pickle.pw

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=pickle
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pickle

# ─── API ─────────────────────────────────────────────────────────
PORT=8080
CONTEXT_TIMEOUT_MS=5000
DEBUG=false
TZ=UTC

ORY_URL=http://pickle-kratos:4433

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pickle-postgres:5432/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://pickle-redis:6379
ELASTICSEARCH_URLS=http://pickle-elastic:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

JWT_SECRET=CHANGE_ME_JWT_SECRET

STEAM_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_AVATAR_BUCKET_NAME=avatars
AWS_S3_PREVIEW_AVATAR_BUCKET_NAME=preview-avatars

API_KEY=CHANGE_ME_API_KEY

IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

CORS_ALLOWED_ORIGINS=https://${PICKLE_DOMAIN}

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
IGDB_IMAGE_URL_FORMAT=https://images.igdb.com/igdb/image/upload/t_%s/%s.jpg
ORDERER_TWITCH_URL_FORMAT=https://twitch.tv/%s
ORDERER_PICKLE_URL_FORMAT=https://${PICKLE_DOMAIN}/%s

# ─── Kratos ──────────────────────────────────────────────────────
SERVE_PUBLIC_BASE_URL=https://${PICKLE_DOMAIN}/ory
SERVE_PUBLIC_CORS_ALLOWED_ORIGINS_0=https://${PICKLE_DOMAIN}
SERVE_ADMIN_BASE_URL=http://pickle-kratos:4434

SESSION_COOKIE_DOMAIN=${PICKLE_DOMAIN}

SELFSERVICE_DEFAULT_BROWSER_RETURN_URL=https://${PICKLE_DOMAIN}/welcome
SELFSERVICE_FLOWS_ERROR_UI_URL=https://${PICKLE_DOMAIN}/auth/error
SELFSERVICE_FLOWS_SETTINGS_UI_URL=https://${PICKLE_DOMAIN}/settings
SELFSERVICE_FLOWS_RECOVERY_UI_URL=https://${PICKLE_DOMAIN}/auth/recovery
SELFSERVICE_FLOWS_VERIFICATION_UI_URL=https://${PICKLE_DOMAIN}/auth/verification
SELFSERVICE_FLOWS_VERIFICATION_AFTER_DEFAULT_BROWSER_RETURN_URL=https://${PICKLE_DOMAIN}
SELFSERVICE_FLOWS_LOGOUT_AFTER_DEFAULT_BROWSER_RETURN_URL=https://${PICKLE_DOMAIN}
SELFSERVICE_FLOWS_LOGIN_UI_URL=https://${PICKLE_DOMAIN}/auth/login
SELFSERVICE_FLOWS_REGISTRATION_UI_URL=https://${PICKLE_DOMAIN}/auth/registration

SECRETS_COOKIE=CHANGE_ME_32_CHAR_RANDOM_STRING_1
SECRETS_CIPHER=CHANGE_ME_32_CHAR_RANDOM_STRING_2

# ─── OIDC Providers ─────────────────────────────────────────────
# Google
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_SECRET=
# Discord
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_SECRET=
# Yandex
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_SECRET=
# Twitch (basic)
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET=
# Twitch (extended) — reuses basic credentials
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_4_CLIENT_ID=${SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_4_CLIENT_SECRET=${SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET}

# ─── Kratos Webhook Integration ─────────────────────────────────
SELFSERVICE_FLOWS_SETTINGS_AFTER_OIDC_HOOKS_0_CONFIG_URL=http://pickle-twitch-harbor:8080/twitch-harbor/v1/webhooks/after-oidc-settings-update
SELFSERVICE_FLOWS_REGISTRATION_AFTER_HOOKS_0_CONFIG_URL=http://pickle-api:8080/v1/webhooks/ory/users
SELFSERVICE_FLOWS_REGISTRATION_AFTER_PASSWORD_HOOKS_2_CONFIG_URL=${SELFSERVICE_FLOWS_REGISTRATION_AFTER_HOOKS_0_CONFIG_URL}
SELFSERVICE_FLOWS_SETTINGS_AFTER_OIDC_HOOKS_0_CONFIG_AUTH_CONFIG_VALUE=${API_KEY}
SELFSERVICE_FLOWS_REGISTRATION_AFTER_HOOKS_0_CONFIG_AUTH_CONFIG_VALUE=${API_KEY}
SELFSERVICE_FLOWS_REGISTRATION_AFTER_PASSWORD_HOOKS_2_CONFIG_AUTH_CONFIG_VALUE=${API_KEY}
